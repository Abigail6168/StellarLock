{
  "name": "stellarlock",
  "version": "0.1.0",
  "description": "StellarLock — secure liquidity locking for Stellar/Soroban",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/StellarLock/StellarLock.git"
  },
  "homepage": "https://github.com/StellarLock/StellarLock",
  "keywords": [
    "stellar",
    "soroban",
    "liquidity",
    "lock",
    "token",
    "defi"
  ],
  "engines": {
    "node": "22"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "dev:testnet": "cp .env.testnet .env && vite --host",
    "dev:staging": "cp .env.staging .env && vite --host",
    "build": "tsc -b && vite build",
    "build:testnet": "cp .env.testnet .env && tsc -b && vite build",
    "build:staging": "cp .env.staging .env && tsc -b && vite build",
    "build:mainnet": "cp .env.mainnet .env && tsc -b && vite build",
    "preview": "vite preview",
    "indexer:start": "tsx indexer/index.ts",
    "notifier:start": "tsx indexer/notifier.ts",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:load": "tsx src/test/load-test-runner.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:i18n": "vitest run src/test/i18n-locales.test.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "changelog": "conventional-changelog -p conventionalcommits -i CHANGELOG.md -s -r 0",
    "changelog:release": "conventional-changelog -p conventionalcommits -i CHANGELOG.md -s"
  },
  "pnpm": {
    "overrides": {
      "protobufjs": "^7.5.6",
      "vite": ">=6.4.3",
      "vitest": "^3.2.6",
      "brace-expansion": ">=2.1.4",
      "js-yaml": ">=4.3.1",
      "fast-uri": ">=3.1.5",
      "ip-address": ">=10.3.1",
      "react-router": ">=7.18.2",
      "nanoid": ">=3.3.18",
      "postcss": ">=8.5.18"
    }
  },
  "dependencies": {
    "@creit.tech/stellar-wallets-kit": "^1.7.6",
    "@stellar/freighter-api": "^6.0.1",
    "@stellar/stellar-sdk": "^13.1.0",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.3.1",
    "i18next-browser-languagedetector": "^8.2.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.16.0",
    "qrcode.react": "3.2.0",
    "react": "^19",
    "react-dom": "^19",
    "react-helmet-async": "^3.0.0",
    "react-hot-toast": "^2.6.0",
    "react-i18next": "^17.0.8",
    "react-router-dom": "^7.17.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.3.1",
    "web-vitals": "^4.0.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^19",
    "@commitlint/config-conventional": "^19",
    "@eslint/js": "^9",
    "@playwright/test": "^1.61.1",
    "@storybook/addon-a11y": "^8.0.0",
    "@storybook/addon-essentials": "^8.0.0",
    "@storybook/addon-interactions": "^8.0.0",
    "@storybook/addon-onboarding": "^8.0.0",
    "@storybook/react": "^8.0.0",
    "@storybook/react-vite": "^8.0.0",
    "@tailwindcss/vite": "^4.3.1",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^14",
    "@testing-library/user-event": "^14",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/ui": "^3.2.6",
    "conventional-changelog-cli": "^5",
    "eslint": "^9",
    "eslint-config-prettier": "^10",
    "eslint-plugin-react-hooks": "^5",
    "eslint-plugin-react-refresh": "^0.4",
    "husky": "^9",
    "jsdom": "^30.0.0",
    "lint-staged": "^15",
    "prettier": "^3",
    "storybook": "^8.6.18",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "5.7.3",
    "typescript-eslint": "^8",
    "vite": "^8.1.0",
    "vitest": "^3.2.7",
    "vitest-axe": "^0.1.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,html}": [
      "prettier --write"
    ]
  }
}
